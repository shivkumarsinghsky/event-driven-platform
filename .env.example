# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# Values below match docker-compose.yml; they are local development defaults, not secrets.

# PostgreSQL — one instance, one schema per service (orders, inventory, notification)
DATABASE_URL=postgres://edp:edp-local-dev@localhost:5432/edp

# RabbitMQ
RABBITMQ_URL=amqp://edp:edp-local-dev@localhost:5672

LOG_LEVEL=info
# Roles this process runs: any of api,relay,consumer
ROLES=api,relay,consumer
# Messages per consumer channel that may be unacknowledged at once
PREFETCH=10
# Delayed retries before dead-lettering (milliseconds, comma-separated)
RETRY_DELAYS_MS=1000,5000,30000
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
# notification-service only: simulated provider failure probability (0..1)
NOTIFICATION_FAILURE_RATE=0.3
