{
  "name": "event-driven-platform",
  "version": "1.0.0",
  "description": "Event-driven architecture reference implementation: RabbitMQ, transactional outbox, idempotent consumers, retries, dead-letter queues, event versioning",
  "author": "Shiv Kumar (https://github.com/shivkumarsinghsky)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "dev:order": "SERVICE_NAME=order-service HTTP_PORT=3001 tsx --env-file=.env src/services/order/main.ts",
    "dev:inventory": "SERVICE_NAME=inventory-service HTTP_PORT=3002 tsx --env-file=.env src/services/inventory/main.ts",
    "dev:notification": "SERVICE_NAME=notification-service HTTP_PORT=3003 tsx --env-file=.env src/services/notification/main.ts",
    "dlq:replay": "tsx scripts/replay-dlq.ts",
    "check:docs": "python3 scripts/check_links.py ."
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
